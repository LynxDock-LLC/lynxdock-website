# Copy to .env.local (or set in Cloudflare Pages env vars) to enable optional
# features. Both are inert when left empty.

# Form endpoint for every site form: demo, beta access, business enquiries
# and the tester hub's beta requirements confirmation. Any service that
# accepts a JSON POST works (e.g. Formspree: https://formspree.io/f/XXXXXXXX).
# When empty, the forms say they are not connected, send nothing and show
# the support email address instead.
#
# Both values are used by PRODUCTION builds only (the main branch, or
# LYNXDOCK_SITE_ENV=production). Preview builds ignore them: their forms are
# switched off and they load no analytics (src/lib/buildEnv.mjs).
NEXT_PUBLIC_FORM_ENDPOINT=

# Cloudflare Web Analytics token (privacy-first, cookieless). Get it from the
# Cloudflare dashboard > Web Analytics > add a site. When empty, no analytics
# script loads at all.
NEXT_PUBLIC_CF_BEACON_TOKEN=
